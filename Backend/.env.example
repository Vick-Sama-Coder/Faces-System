DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=SalaoFaces
DATABASE_USER=postgres
DATABASE_PASSWORD=altere-esta-password
DATABASE_MAINTENANCE_DB=postgres
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
PORT=5000
JWT_SECRET=altere-este-valor
# Fuso horario do negocio (usado pela rotina automatica e pelo fecho diario).
TZ=Africa/Maputo
# Rotina automatica do caixa (hora local do servidor).
# A sessao do dia anterior e fechada apos a meia-noite e a do dia e aberta a partir das 08h.
CAIXA_HORA_ABERTURA=8
CAIXA_AUTOMATICO_INTERVALO_MS=30000
# Pode conter varias origens separadas por virgulas (producao + preview).
# Ex.: https://faces-system.vercel.app,http://localhost:5173/
CLIENT_URL=https://faces-system.vercel.app

